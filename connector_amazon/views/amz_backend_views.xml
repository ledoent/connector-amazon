<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_amz_backend_form" model="ir.ui.view">
        <field name="name">amz.backend.form</field>
        <field name="model">amz.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        text="Sandbox"
                        bg_color="bg-warning"
                        invisible="not sandbox"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Backend Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="client_id" />
                            <field name="client_secret" password="True" />
                            <field name="refresh_token" password="True" />
                            <field name="sandbox" />
                        </group>
                        <group string="Marketplace">
                            <field name="marketplace_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="warehouse_id" />
                        </group>
                    </group>
                    <group string="Import Settings">
                        <field name="import_days_back" />
                        <field name="last_import_date" readonly="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_amz_backend_list" model="ir.ui.view">
        <field name="name">amz.backend.list</field>
        <field name="model">amz.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="marketplace_id" />
                <field name="sandbox" />
                <field name="last_import_date" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="action_amz_backend" model="ir.actions.act_window">
        <field name="name">Amazon Backends</field>
        <field name="res_model">amz.backend</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_amz_root"
        name="Amazon"
        sequence="50"
        groups="connector_amazon.group_amz_user"
    />
    <menuitem
        id="menu_amz_config"
        name="Configuration"
        parent="menu_amz_root"
        sequence="90"
        groups="connector_amazon.group_amz_manager"
    />
    <menuitem
        id="menu_amz_backends"
        name="Backends"
        parent="menu_amz_config"
        action="action_amz_backend"
        sequence="10"
    />
</odoo>
