<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_import_orders" model="ir.cron">
        <field name="name">Amazon: Import Orders</field>
        <field name="model_id" ref="model_amz_backend" />
        <field name="state">code</field>
        <field name="code">
            for backend in env["amz.backend"].search([("active", "=", True)]):
                backend.with_delay().import_orders()
        </field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>
</odoo>
