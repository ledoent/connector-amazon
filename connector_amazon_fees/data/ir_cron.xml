<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_sync_fees" model="ir.cron">
        <field name="name">Amazon: Sync Fees</field>
        <field name="model_id" ref="connector_amazon.model_amz_backend" />
        <field name="state">code</field>
        <field
            name="code"
        >env["amz.backend"].search([("active", "=", True)]).sync_fees()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False" />
    </record>
</odoo>
