<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_amz_price_history_list" model="ir.ui.view">
        <field name="name">amz.price.history.list</field>
        <field name="model">amz.price.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="backend_id" optional="show" />
                <field name="seller_sku" />
                <field name="old_price" />
                <field name="new_price" />
                <field name="pricing_rule" optional="show" />
                <field name="trigger" />
                <field name="user_id" optional="hide" />
                <field name="currency_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_amz_price_history_search" model="ir.ui.view">
        <field name="name">amz.price.history.search</field>
        <field name="model">amz.price.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="seller_sku" />
                <field name="listing_id" />
                <field name="backend_id" />
                <filter
                    name="manual"
                    string="Manual"
                    domain="[('trigger', '=', 'manual')]"
                />
                <filter
                    name="cron"
                    string="Scheduled"
                    domain="[('trigger', '=', 'cron')]"
                />
                <filter
                    name="notification"
                    string="Offer Notification"
                    domain="[('trigger', '=', 'notification')]"
                />
                <group>
                    <filter
                        name="group_trigger"
                        string="Trigger"
                        context="{'group_by': 'trigger'}"
                    />
                    <filter
                        name="group_listing"
                        string="Listing"
                        context="{'group_by': 'listing_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_amz_price_history" model="ir.actions.act_window">
        <field name="name">Price History</field>
        <field name="res_model">amz.price.history</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_amz_price_history_search" />
    </record>

    <menuitem
        id="menu_amz_price_history"
        name="Price History"
        parent="connector_amazon.menu_amz_root"
        action="action_amz_price_history"
        sequence="25"
        groups="connector_amazon.group_amz_user"
    />
</odoo>
