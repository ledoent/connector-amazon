<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_sync_prices" model="ir.cron">
        <field name="name">Amazon: Sync Prices</field>
        <field name="model_id" ref="connector_amazon.model_amz_backend" />
        <field name="state">code</field>
        <field name="code">
            env["amz.backend"].search([("active", "=", True), ("price_push_enabled", "=", True)]).sync_prices()
        </field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>
</odoo>
