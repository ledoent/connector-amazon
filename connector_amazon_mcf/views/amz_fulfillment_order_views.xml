<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_amz_fulfillment_order_list" model="ir.ui.view">
        <field name="name">amz.fulfillment.order.list</field>
        <field name="model">amz.fulfillment.order</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'complete'"
                decoration-muted="state in ['cancelled', 'invalid']"
                decoration-info="state == 'processing'"
            >
                <field name="name" />
                <field name="create_date" />
                <field name="picking_id" />
                <field name="partner_id" />
                <field name="shipping_speed" />
                <field name="tracking_numbers" optional="show" />
                <field name="amazon_status" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'complete'"
                    decoration-info="state == 'processing'"
                    decoration-warning="state == 'submitted'"
                    decoration-muted="state in ['cancelled', 'invalid']"
                />
            </list>
        </field>
    </record>

    <record id="view_amz_fulfillment_order_form" model="ir.ui.view">
        <field name="name">amz.fulfillment.order.form</field>
        <field name="model">amz.fulfillment.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit to Amazon"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_check_status"
                        type="object"
                        string="Check Status"
                        invisible="state in ['draft', 'cancelled', 'invalid']"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        confirm="Cancel this Amazon fulfillment order?"
                        invisible="state in ['complete', 'cancelled', 'invalid']"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,processing,complete"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1" />
                            <field name="backend_id" readonly="state != 'draft'" />
                            <field name="partner_id" readonly="state != 'draft'" />
                            <field name="shipping_speed" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field
                                name="displayable_order_id"
                                readonly="state != 'draft'"
                            />
                            <field name="amazon_status" />
                            <field name="carrier" />
                            <field name="tracking_numbers" />
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" />
                            <field name="seller_sku" />
                            <field name="item_id" />
                            <field name="quantity" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amz_fulfillment_order_search" model="ir.ui.view">
        <field name="name">amz.fulfillment.order.search</field>
        <field name="model">amz.fulfillment.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="picking_id" />
                <field name="partner_id" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('state', 'in', ['submitted', 'processing'])]"
                />
                <filter
                    name="complete"
                    string="Complete"
                    domain="[('state', '=', 'complete')]"
                />
                <group>
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_amz_fulfillment_order" model="ir.actions.act_window">
        <field name="name">MCF Orders</field>
        <field name="res_model">amz.fulfillment.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amz_fulfillment_order_search" />
    </record>

    <menuitem
        id="menu_amz_fulfillment_order"
        name="MCF Orders"
        parent="connector_amazon.menu_amz_fulfillment"
        action="action_amz_fulfillment_order"
        sequence="30"
        groups="connector_amazon.group_amz_user"
    />
</odoo>
