<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_amz_shipment_list" model="ir.ui.view">
        <field name="name">amz.shipment.list</field>
        <field name="model">amz.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" />
                <field name="picking_id" />
                <field name="order_id" optional="show" />
                <field name="carrier_name" />
                <field name="service_name" />
                <field name="tracking_number" />
                <field name="cost" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_amz_shipment_form" model="ir.ui.view">
        <field name="name">amz.shipment.form</field>
        <field name="model">amz.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_download_label"
                        type="object"
                        string="Download Label"
                        class="btn-primary"
                        invisible="not label_attachment_id"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Shipment">
                            <field name="picking_id" />
                            <field name="order_id" />
                            <field name="backend_id" />
                            <field name="amazon_shipment_id" />
                            <field name="tracking_number" />
                        </group>
                        <group string="Service">
                            <field name="carrier_name" />
                            <field name="service_name" />
                            <field name="currency_id" invisible="1" />
                            <field name="cost" />
                            <field name="label_attachment_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_amz_shipment" model="ir.actions.act_window">
        <field name="name">Amazon Shipments</field>
        <field name="res_model">amz.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_amz_shipment"
        name="Amazon Shipments"
        parent="connector_amazon.menu_amz_fulfillment"
        action="action_amz_shipment"
        sequence="20"
        groups="connector_amazon.group_amz_user"
    />
</odoo>
