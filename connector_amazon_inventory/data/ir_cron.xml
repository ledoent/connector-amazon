<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_push_inventory" model="ir.cron">
        <field name="name">Amazon: Push Inventory</field>
        <field name="model_id" ref="connector_amazon.model_amz_backend" />
        <field name="state">code</field>
        <field name="code">
            env["amz.backend"].search([("active", "=", True), ("inventory_sync_enabled", "=", True)]).push_inventory()
        </field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>
</odoo>
