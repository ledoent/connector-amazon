<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_poll_offer_notifications" model="ir.cron">
        <field name="name">Amazon: Poll Offer Notifications (SQS)</field>
        <field name="model_id" ref="connector_amazon.model_amz_backend" />
        <field name="state">code</field>
        <field name="code">
            env["amz.backend"].search([
                ("active", "=", True),
                ("notifications_enabled", "=", True),
            ]).poll_offer_notifications()
        </field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>
</odoo>
