<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_amz_sync_fba_inventory" model="ir.cron">
        <field name="name">Amazon: Sync FBA Inventory</field>
        <field name="model_id" ref="connector_amazon.model_amz_backend" />
        <field name="state">code</field>
        <field name="code">
            env["amz.backend"].search([("active", "=", True)]).sync_fba_inventory()
        </field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False" />
    </record>
</odoo>
